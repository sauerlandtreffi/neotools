# Copy to .env next to docker-compose.yml. Do not commit real keys.
NEOTOOLS_API_KEYS=dev-key-change-me
NEOTOOLS_LICENSE=
NEOTOOLS_LICENSE_PUBKEY=
NEOTOOLS_PRESETS=
NEOTOOLS_MAX_UPLOAD_BYTES=52428800
NEOTOOLS_MAX_PARALLEL=2
NEOTOOLS_JOB_TIMEOUT_MS=120000
# watch profile
NEOTOOLS_WATCH_IN=./watch-in
NEOTOOLS_WATCH_OUT=./watch-out
NEOTOOLS_WATCH_PIPELINE=./pipeline.json
