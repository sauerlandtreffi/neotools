{
  "name": "@neotools/tools-office",
  "version": "0.1.0",
  "description": "Office-, E-Book- und Daten-Werkzeuge für NeoTools (DOCX/MD/HTML/PDF, XLSX, PPTX, EPUB).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "fonts": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.8",
    "@neotools/engine": "workspace:*",
    "@neotools/tools-image": "workspace:*",
    "@neotools/tools-pdf": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "bwip-js": "^4.7.0",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.3",
    "fonteditor-core": "^2.6.3",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.6.3",
    "katex": "^0.16.22",
    "mammoth": "^1.11.0",
    "marked": "^15.0.12",
    "opentype.js": "^1.3.4",
    "papaparse": "^5.5.3",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.13.0",
    "wawoff2": "^2.0.1",
    "xlsx": "0.18.5",
    "yaml": "^2.8.1",
    "zod": "^3.24.2",
    "zxing-wasm": "^2.2.4"
  },
  "devDependencies": {
    "@types/bwip-js": "^3.2.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.18.1",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
