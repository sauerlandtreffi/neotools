{
  "id": "erv",
  "version": "2026-01",
  "sources": [
    {
      "id": "ERVV-§2",
      "title": "Elektronischer-Rechtsverkehr-Verordnung § 2",
      "note": "Form und Übermittlung elektronischer Dokumente; Dateiformat PDF."
    },
    {
      "id": "ERVV-§5",
      "title": "Elektronischer-Rechtsverkehr-Verordnung § 5",
      "note": "Container, Struktur und technische Rahmenbedingungen."
    },
    {
      "id": "ERVB",
      "title": "Elektronischer-Rechtsverkehr-Bekanntmachung (aktuell gehalten)",
      "note": "Dateigrößen, Dateinamen, Höchstzahl. Werte als Konfiguration, nicht fest verdrahtet im Code."
    }
  ],
  "limits": {
    "maxFilenameChars": 90,
    "filenamePattern": "^[A-Za-z0-9_.-]+$",
    "maxFileBytes": 209715200,
    "maxMessageBytes": 1048576000,
    "maxFiles": 1000
  },
