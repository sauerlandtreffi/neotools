{
  "name": "@neotools/tools-speech",
  "version": "0.1.0",
  "description": "Sprache & Untertitel: Whisper, Untertitel-Werkzeuge, Transkript-Analysen.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models.json": "./src/models/models.json"
  },
  "files": ["dist", "src/models/models.json", "scripts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@neotools/engine": "workspace:*",
    "@neotools/models": "workspace:*",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@neotools/parsers": "workspace:*",
    "@neotools/tools-image": "workspace:*",
    "@neotools/tools-image-ai": "workspace:*",
    "@neotools/tools-media": "workspace:*",
    "@neotools/tools-pdf": "workspace:*",
    "@wasm-audio-decoders/flac": "^0.2.8",
    "mpg123-decoder": "^1.0.3",
    "ogg-opus-decoder": "^1.7.3",
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
