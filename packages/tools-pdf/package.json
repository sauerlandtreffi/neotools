{
  "name": "@neotools/tools-pdf",
  "version": "0.1.0",
  "description": "PDF-Werkzeuge für NeoTools (pdf-lib + pdfjs-dist).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.0",
    "@jspawn/qpdf-wasm": "0.0.2",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@neotools/engine": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "asn1js": "^3.0.6",
    "diff": "^7.0.0",
    "fflate": "^0.8.3",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pkijs": "^3.2.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.80"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.18.1",
    "@types/node-forge": "^1.3.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
