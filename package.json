{
  "name": "neotools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokale Browser-, CLI- und Desktop-Tools für PDFs — ohne Upload, ohne Tracking.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @neotools/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "e2e": "node apps/web/e2e/ensure-dist.mjs && pnpm --filter @neotools/web e2e",
    "cli": "pnpm --filter @neotools/cli neotools",
    "postinstall": "node scripts/copy-wasm-assets.mjs && node scripts/fetch-tessdata.mjs --optional",
    "assets": "node scripts/copy-wasm-assets.mjs && node scripts/fetch-tessdata.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "globals": "^16.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
