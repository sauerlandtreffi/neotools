---
import Base from '../../layouts/Base.astro';
import FormatDoc from '../../components/pages/FormatDoc.astro';
import { branding } from '../../lib/branding';
import { localePath } from '../../lib/i18n';
import { breadcrumbList, faqPage, techArticle } from '../../lib/seo-jsonld';
import { formatFaq } from '../../lib/format-faq';
import { buildConversionMatrix, listFormats, requireFormat } from '../../data/formats';
import { registry } from '../../lib/registry';

export function getStaticPaths() {
  return listFormats().map((format) => ({ params: { id: format.id } }));
}

const locale = 'de' as const;
const format = requireFormat(Astro.params.id!);
const conversions = buildConversionMatrix(registry);
const faq = formatFaq(format, conversions);
const site = Astro.site ?? new URL('https://neotools.local');
const path = `/formats/${format.id}`;
const jsonLd = [
  techArticle(locale, format, new URL(localePath(locale, path), site).toString()),
  faqPage(locale, faq),
  breadcrumbList(locale, site, [
    { name: branding.name, path: localePath(locale, '/') },
    { name: 'Formate', path: localePath(locale, '/formats') },
    { name: format.names[locale], path: localePath(locale, path) },
  ]),
];
---
<Base locale={locale} title={format.names.de} description={format.typicalUse.de} path={path} jsonLd={jsonLd}>
  <FormatDoc locale={locale} format={format} conversions={conversions} faq={faq} />
</Base>
