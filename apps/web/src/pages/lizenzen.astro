---
import Base from '../layouts/Base.astro';
import { licenses } from '../lib/registry';
---
<Base locale="de" title="Lizenzen" description="Lizenzen aller gebündelten Bibliotheken" path="/lizenzen">
  <h1 class="text-4xl">Lizenzen</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">
    Eigener Code steht unter MIT. Laufzeitbibliotheken sind gebündelt, keine AGPL-Abhängigkeiten (kein Ghostscript, MuPDF, iText).
  </p>
  <ul class="mt-8 grid gap-3">
    {licenses.map((lic) => (
      <li class="rounded border p-3" style="border-color: var(--line)">
        <strong>{lic.name}</strong>
        <div class="mono text-sm">{lic.license}</div>
        <a href={lic.url}>{lic.url}</a>
      </li>
    ))}
  </ul>
</Base>
