---
import { getAppliedPresets, zodObjectFields } from '@neotools/engine';
import Base from '../layouts/Base.astro';
import PipelineBuilder from '../components/PipelineBuilder.tsx';
import { listPublicTools } from '../lib/visible-tools';
import { resolvePipelineLibrary } from '../lib/pipeline-library';
import { registry } from '../lib/registry';

const applied = getAppliedPresets(registry);
const catalog = listPublicTools().map((tool) => ({
  id: tool.id,
  title: tool.title,
  fields: zodObjectFields(tool.options),
  accept: tool.inputs.accept,
  outputs: tool.outputs?.mime ?? [],
  pack: tool.pack,
  lockedKeys: applied?.locked?.[tool.id] ?? [],
}));
const library = resolvePipelineLibrary(registry);
const required = Object.entries(applied?.requiredPipelines ?? {}).map(([name, tools]) => ({ name, tools }));
---
<Base locale="de" title="Pipeline" description="Mehrere Werkzeuge hintereinander, teilbar per URL-Hash" path="/pipeline">
  <h1 class="text-4xl">Pipeline</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">
    Schritte aus allen Packs, MIME-Prüfung, leichte Verzweigung, Presets. Der Link speichert die Pipeline im Hash <span class="mono">#p=</span>.
  </p>
  <div class="mt-8">
    <PipelineBuilder
      client:load
      locale="de"
      catalogJson={JSON.stringify(catalog)}
      libraryJson={JSON.stringify(library)}
      requiredJson={JSON.stringify(required)}
    />
  </div>
</Base>
