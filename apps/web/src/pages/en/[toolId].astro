---
import { getCollection } from 'astro:content';
import { getAppliedPresets, zodObjectFields } from '@neotools/engine';
import Base from '../../layouts/Base.astro';
import ToolApp from '../../components/ToolApp.tsx';
import { registry, toolPaths } from '../../lib/registry';
import { localePath, t } from '../../lib/i18n';
import { formatsForTool } from '../../data/formats';
import { guideSlugFromId } from '../../lib/guides';

export function getStaticPaths() {
  return toolPaths();
}

const locale = 'en' as const;
const tool = registry.require(Astro.params.toolId!);
const fields = zodObjectFields(tool.options);
const meta = {
  id: tool.id,
  inputs: tool.inputs,
  presets: tool.presets,
  ui: tool.ui ?? null,
  lockedKeys: getAppliedPresets(registry)?.locked?.[tool.id] ?? [],
};
const related = formatsForTool(tool);
let guides: Array<{ slug: string; title: string }> = [];
try {
  guides = (await getCollection('guides'))
    .filter((entry) => entry.data.locale === locale && entry.data.tool === tool.id)
    .map((entry) => ({ slug: guideSlugFromId(entry.id, locale), title: entry.data.title }));
} catch {
  guides = [];
}
---
<Base locale={locale} title={tool.title.en} description={tool.description.en} path={`/${tool.id}`} tool={tool}>
  <p class="stamp" style="color: var(--accent)">{tool.id}</p>
  <h1 class="mt-2 text-4xl">{tool.title.en}</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">{tool.description.en}</p>
  <div class="mt-8">
    <ToolApp client:load locale={locale} toolId={tool.id} fieldsJson={JSON.stringify(fields)} metaJson={JSON.stringify(meta)} />
  </div>
  {guides.length > 0 && (
    <section class="mt-12">
      <h2 class="text-2xl">{t(locale, 'relatedGuides')}</h2>
      <ul class="mt-3 grid gap-2">
        {guides.map((guide) => (
          <li><a href={localePath(locale, `/guides/${guide.slug}`)}>{guide.title}</a></li>
        ))}
      </ul>
    </section>
  )}
  {(related.inputs.length > 0 || related.outputs.length > 0) && (
    <section class="mt-12">
      <h2 class="text-2xl">{t(locale, 'formats')}</h2>
      <p class="mt-2 text-sm">
        {related.inputs.map((f) => (
          <a class="mr-3" href={localePath(locale, `/formats/${f.id}`)}>{f.names.en}</a>
        ))}
        {related.outputs.map((f) => (
          <a class="mr-3" href={localePath(locale, `/formats/${f.id}`)}>{f.names.en}</a>
        ))}
      </p>
    </section>
  )}
  {tool.seo?.faq && (
    <section class="mt-12">
      <h2 class="text-2xl">{t(locale, 'faq')}</h2>
      {tool.seo.faq.map((item) => (
        <details class="mt-3">
          <summary>{item.q.en}</summary>
          <p class="mt-2" style="color: var(--muted)">{item.a.en}</p>
        </details>
      ))}
    </section>
  )}
</Base>
