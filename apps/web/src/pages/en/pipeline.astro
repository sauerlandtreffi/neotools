---
import { zodObjectFields } from '@neotools/engine';
import Base from '../../layouts/Base.astro';
import PipelineBuilder from '../../components/PipelineBuilder.tsx';
import { tools } from '../../lib/registry';

const catalog = tools.map((tool) => ({
  id: tool.id,
  title: tool.title,
  fields: zodObjectFields(tool.options),
}));
---
<Base locale="en" title="Pipeline" description="Chain tools and share the URL hash" path="/pipeline">
  <h1 class="text-4xl">Pipeline</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">
    Add steps, set options, run. The shareable link stores the pipeline in <span class="mono">#p=</span>.
  </p>
  <div class="mt-8">
    <PipelineBuilder client:load locale="en" catalogJson={JSON.stringify(catalog)} />
  </div>
</Base>
