---
import Base from '../../../../layouts/Base.astro';
import ToolDoc from '../../../../components/ToolDoc.astro';
import { registry, toolPaths } from '../../../../lib/registry';

export function getStaticPaths() {
  return toolPaths();
}
const locale = 'en' as const;
const tool = registry.require(Astro.params.toolId!);
---
<Base locale={locale} title={tool.title.en} description={tool.description.en} path={`/tools/${tool.id}`} tool={tool}>
  <ToolDoc locale={locale} tool={tool} />
</Base>
