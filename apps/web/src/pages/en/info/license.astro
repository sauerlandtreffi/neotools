---
import Base from '../../../layouts/Base.astro';
import LicenseApp from '../../../components/LicenseApp.tsx';
import { branding } from '../../../lib/branding';
---
<Base locale="en" title="License" description="Offline license key, Community stays free" path="/license">
  <h1 class="text-4xl">License</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">
    The token is verified locally (IndexedDB) — no phone-home. Without a token, Community applies: every tool stays free.
  </p>
  <div class="mt-8">
    <LicenseApp client:load locale="en" pubkey={branding.licensePubkey ?? ''} embedded={branding.license ?? ''} />
  </div>
</Base>
