---
import Base from '../../../layouts/Base.astro';
import { infoPath, t } from '../../../lib/i18n';
import { listPublicTools } from '../../../lib/visible-tools';
const locale = 'en' as const;
const de = locale === 'de';
const count = listPublicTools().length;
const links = [
  { href: infoPath(locale, '/tools'), label: `${t(locale, 'tools')} (${count})` },
  { href: infoPath(locale, '/formats'), label: t(locale, 'formats') },
  { href: infoPath(locale, '/convert'), label: t(locale, 'convert') },
  { href: infoPath(locale, '/guides'), label: t(locale, 'guides') },
  { href: infoPath(locale, de ? '/vergleich/ilovepdf' : '/compare/ilovepdf'), label: t(locale, 'compare') },
  { href: infoPath(locale, de ? '/preise' : '/pricing'), label: t(locale, 'pricing') },
  { href: infoPath(locale, de ? '/ueber' : '/about'), label: t(locale, 'about') },
  { href: infoPath(locale, '/no-upload'), label: t(locale, 'noUpload') },
  { href: infoPath(locale, '/spec'), label: t(locale, 'spec') },
  { href: infoPath(locale, de ? '/lizenzen' : '/licenses'), label: t(locale, 'licenses') },
  { href: infoPath(locale, de ? '/impressum' : '/imprint'), label: t(locale, 'imprint') },
  { href: infoPath(locale, de ? '/datenschutz' : '/privacy'), label: t(locale, 'privacy') },
];
---
<Base locale={locale} title="Info area" description="Tools, formats, conversions, guides, comparisons, pricing, legal." path="/">
  <h1>{t(locale, 'infoHub')}</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">{t(locale, 'infoHubLead')}</p>
  <ul class="mt-8 grid gap-2 sm:grid-cols-2">
    {links.map((l) => (
      <li><a class="block rounded-md border p-3 no-underline" style="border-color: var(--line); background: var(--card)" href={l.href}>{l.label}</a></li>
    ))}
  </ul>
</Base>
