---
import Base from '../../layouts/Base.astro';
import OpenApp from '../../components/OpenApp.tsx';
import ReaderLaunch from '../../components/ReaderLaunch.tsx';
import { listPublicTools } from '../../lib/visible-tools';
const payload = JSON.stringify(listPublicTools().map((t) => ({ id: t.id, title: t.title, accept: t.inputs.accept })));
---
<Base locale="en" title="Open file" description="Detect the file type and suggest a tool" path="/open">
  <h1 class="text-4xl">Open file</h1>
  <p class="mt-3" style="color: var(--muted)">PWA file handlers and the share target land here. PDFs and images open the workspace.</p>
  <div class="mt-6">
    <ReaderLaunch client:load locale="en" />
    <OpenApp client:load locale="en" toolsJson={payload} />
  </div>
</Base>
