---
import Base from '../../layouts/Base.astro';
import { localePath } from '../../lib/i18n';
---
<Base locale="en" title="Offline" description="The app shell is here; packs come from the cache" path="/offline">
  <h1 class="text-4xl">Offline</h1>
  <p class="mt-4 max-w-2xl">
    You are seeing this because the network is gone. The app shell and already loaded tools/WASM live in the cache (stale-while-revalidate).
  </p>
  <p class="mt-3"><a href={localePath('en', '/')}>Home</a></p>
</Base>
