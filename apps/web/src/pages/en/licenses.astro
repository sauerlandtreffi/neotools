---
import Base from '../../layouts/Base.astro';
import { licenses } from '../../lib/registry';
---
<Base locale="en" title="Licenses" description="Licenses of every bundled library" path="/licenses">
  <h1 class="text-4xl">Licenses</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">
    First-party code is MIT. Runtime libraries are bundled. No AGPL dependencies (no Ghostscript, MuPDF, iText).
  </p>
  <ul class="mt-8 grid gap-3">
    {licenses.map((lic) => (
      <li class="rounded border p-3" style="border-color: var(--line)">
        <strong>{lic.name}</strong>
        <div class="mono text-sm">{lic.license}</div>
        <a href={lic.url}>{lic.url}</a>
      </li>
    ))}
  </ul>
</Base>
