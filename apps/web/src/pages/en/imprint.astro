---
import Base from '../../layouts/Base.astro';
import LandingLegalNote from '../../components/LandingLegalNote.astro';
import { branding, brandingContactEmail, brandingSlot } from '../../lib/branding';

const legal = branding.legal;
const email = brandingContactEmail(branding);
const operator = brandingSlot(legal.operator, '[legal.operator — name / company]');
const address = brandingSlot(legal.address, '[legal.address — street, postcode, city, country]');
const mail = brandingSlot(email, '[legal.email / contact.email]');
const phone = brandingSlot(legal.phone, '[legal.phone]');
const vat = brandingSlot(legal.vatId, '[legal.vatId — VAT ID if any]');
const register = brandingSlot(legal.register, '[legal.register — court and number if any]');
const responsible = brandingSlot(legal.responsible, '[legal.responsible — § 18 MStV if applicable]');
---
<Base locale="en" title="Legal notice" description="Legal notice template (German DDG / MStV fields)" path="/imprint">
  <h1 class="text-4xl">Legal notice</h1>
  <p class="stamp mt-4" style="color: var(--accent)">Template · as of {legal.updated}</p>
  <p class="mt-4 max-w-2xl text-sm" style="color: var(--muted)">
    This operator is established in Germany. The binding text is the German
    <a href="/impressum">Impressum</a>.
  </p>
  <section class="prose mt-8 max-w-2xl">
    <h2>Provider</h2>
    <p class="whitespace-pre-wrap">{operator}</p>
    <p class="whitespace-pre-wrap">{address}</p>
    <h2>Contact</h2>
    <p>Email: {mail.includes('[') ? mail : <a href={'mailto:' + mail}>{mail}</a>}</p>
    <p>Phone: {phone}</p>
    <h2>Register and VAT</h2>
    <p>{register}</p>
    <p>VAT ID: {vat}</p>
    <h2>Responsible (MStV)</h2>
    <p class="whitespace-pre-wrap">{responsible}</p>
  </section>
  <LandingLegalNote locale="en" />
</Base>
