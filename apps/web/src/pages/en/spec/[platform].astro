---
import Base from '../../../layouts/Base.astro';
import SpecDoc from '../../../components/pages/SpecDoc.astro';
import { branding } from '../../../lib/branding';
import { localePath } from '../../../lib/i18n';
import { breadcrumbList } from '../../../lib/seo-jsonld';
import { getPlatformSpec, listPlatformSpecs } from '../../../data/specs';

export function getStaticPaths() {
  return listPlatformSpecs().map((spec) => ({ params: { platform: spec.id } }));
}

const locale = 'en' as const;
const spec = getPlatformSpec(Astro.params.platform!);
if (!spec) throw new Error('Unknown platform');
const site = Astro.site ?? new URL('https://neotools.local');
const path = `/spec/${spec.id}`;
---
<Base
  locale={locale}
  title={spec.name.en}
  description={spec.summary.en}
  path={path}
  jsonLd={[
    breadcrumbList(locale, site, [
      { name: branding.name, path: localePath(locale, '/') },
      { name: 'Limits', path: localePath(locale, '/spec') },
      { name: spec.name.en, path: localePath(locale, path) },
    ]),
  ]}
>
  <SpecDoc locale={locale} spec={spec} />
</Base>
