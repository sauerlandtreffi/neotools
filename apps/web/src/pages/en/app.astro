---
import AppBase from '../../layouts/AppBase.astro';
import WorkspaceApp from '../../components/workspace/WorkspaceApp.tsx';
import { branding } from '../../lib/branding';

/* Deep-link route (noindex): the full-screen shell without the explanation below. */
const locale = 'en' as const;
---
<AppBase locale={locale} title="Workspace" description="Every tool in one tab – locally in your browser." path="/app" canonical="/en">
  <WorkspaceApp client:load locale={locale} brandName={branding.name} logo={branding.logo} licensePubkey={branding.licensePubkey ?? ''} licenseEmbedded={branding.license ?? ''} />
</AppBase>
