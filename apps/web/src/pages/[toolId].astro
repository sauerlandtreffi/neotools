---
import AppBase from '../layouts/AppBase.astro';
import Landing from '../components/landing/Landing.astro';
import WorkspaceApp from '../components/workspace/WorkspaceApp.tsx';
import { branding } from '../lib/branding';
import { registry, toolPaths } from '../lib/registry';

/* App deep-link (pivot §11.1/7): `/` with the shell expanded and the tool pre-selected.
   noindex; the documentation lives at /info/tools/{id} (canonical). */
export function getStaticPaths() {
  return toolPaths();
}
const locale = 'de' as const;
const tool = registry.require(Astro.params.toolId!);
---
<AppBase locale={locale} title={tool.title.de} description={tool.description.de} path={`/${tool.id}`} canonical={`/info/tools/${tool.id}`}>
  <WorkspaceApp
    client:load
    locale={locale}
    embedded
    initialTool={tool.id}
    brandName={branding.name}
    logo={branding.logo}
    licensePubkey={branding.licensePubkey ?? ''}
    licenseEmbedded={branding.license ?? ''}
  />
  <Landing locale={locale} />
</AppBase>
