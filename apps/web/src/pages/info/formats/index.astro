---
import Base from '../../../layouts/Base.astro';
import { localePath } from '../../../lib/i18n';
import { listFormats } from '../../../data/formats';
const locale = 'de' as const;
const formats = listFormats();
---
<Base locale={locale} title="Formate" description="Steckbriefe zu Bild-, Dokument-, Archiv- und Medienformaten" path="/formats">
  <h1 class="text-4xl">Formate</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">Wissensbasis für Konverter, Spec-Checks und SEO. Tools hängen automatisch an, sobald ein Pack sie registriert.</p>
  <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {formats.map((format) => (
      <li class="rounded-lg border p-3" style="border-color: var(--line)">
        <a href={localePath(locale, `/formats/${format.id}`)}>
          <span class="mono text-xs">{format.id}</span>
          <div>{format.names.de}</div>
        </a>
      </li>
    ))}
  </ul>
</Base>
