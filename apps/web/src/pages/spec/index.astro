---
import Base from '../../layouts/Base.astro';
import { localePath } from '../../lib/i18n';
import { listPlatformSpecs } from '../../data/specs';
const locale = 'de' as const;
---
<Base locale={locale} title="Plattform-Limits" description="WhatsApp, Instagram, beA und andere Limits mit Quelle und Datum" path="/spec">
  <h1 class="text-4xl">Plattform-Limits</h1>
  <ul class="mt-8 grid gap-3">
    {listPlatformSpecs().map((spec) => (
      <li class="rounded border p-3" style="border-color: var(--line)">
        <a href={localePath(locale, `/spec/${spec.id}`)}>{spec.name.de}</a>
        <p class="text-sm" style="color: var(--muted)">{spec.summary.de}</p>
      </li>
    ))}
  </ul>
</Base>
