---
import Base from '../layouts/Base.astro';
import WatchApp from '../components/WatchApp.tsx';
import { branding } from '../lib/branding';
---
<Base locale="de" title="Watch-Ordner" description="Lokale Ordnerregeln im Chromium-Tab" path="/watch">
  <h1 class="text-4xl">Watch-Ordner</h1>
  <p class="mt-3 max-w-2xl" style="color: var(--muted)">
    Dateien bleiben auf dem Gerät. Ergebnisse nach <span class="mono">neotools-out/</span>, Journal im Verlauf.
  </p>
  <div class="mt-8">
    <WatchApp client:load locale="de" pubkey={branding.licensePubkey ?? ''} embedded={branding.license ?? ''} />
  </div>
</Base>
