---
import Base from '../layouts/Base.astro';
import OpenApp from '../components/OpenApp.tsx';
import ReaderLaunch from '../components/ReaderLaunch.tsx';
import { tools } from '../lib/registry';
const payload = JSON.stringify(tools.map((t) => ({ id: t.id, title: t.title, accept: t.inputs.accept })));
---
<Base locale="de" title="Datei öffnen" description="Dateityp erkennen und Werkzeug vorschlagen" path="/open">
  <h1 class="text-4xl">Datei öffnen</h1>
  <p class="mt-3" style="color: var(--muted)">PWA file_handlers und Share Target landen hier. PDFs öffnen den Reader.</p>
  <div class="mt-6">
    <ReaderLaunch client:load locale="de" />
    <OpenApp client:load locale="de" toolsJson={payload} />
  </div>
</Base>
