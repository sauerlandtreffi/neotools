---
/**
 * Impressum-Vorlage (§ 5 DDG, § 18 MStV). Keine Rechtsberatung.
 * Pflichtangaben kommen aus branding.json → legal.*.
 * Leere Felder bleiben als sichtbare Platzhalter stehen.
 */
import Base from '../layouts/Base.astro';
import LandingLegalNote from '../components/LandingLegalNote.astro';
import { branding, brandingContactEmail, brandingSlot } from '../lib/branding';

const legal = branding.legal;
const email = brandingContactEmail(branding);
const operator = brandingSlot(legal.operator, '[legal.operator — Name / Firma]');
const address = brandingSlot(legal.address, '[legal.address — Straße, PLZ Ort, Land]');
const mail = brandingSlot(email, '[legal.email / contact.email]');
const phone = brandingSlot(legal.phone, '[legal.phone — Telefon, falls vorhanden]');
const vat = brandingSlot(legal.vatId, '[legal.vatId — USt-IdNr., falls vorhanden]');
const register = brandingSlot(legal.register, '[legal.register — Registergericht und Nummer, falls vorhanden]');
const responsible = brandingSlot(
  legal.responsible,
  '[legal.responsible — verantwortlich nach § 18 MStV, falls anwendbar]',
);
---
<Base locale="de" title="Impressum" description="Impressum (Vorlage nach § 5 DDG / § 18 MStV)" path="/impressum">
  <h1 class="text-4xl">Impressum</h1>
  <p class="stamp mt-4" style="color: var(--accent)">Vorlage · Stand {legal.updated}</p>

  <section class="prose mt-8 max-w-2xl">
    <h2>Anbieter</h2>
    <p>
      Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG):
    </p>
    <p class="whitespace-pre-wrap">{operator}</p>
    <p class="whitespace-pre-wrap">{address}</p>

    <h2>Kontakt</h2>
    <p>
      E-Mail: {mail.includes('[') ? mail : <a href={'mailto:' + mail}>{mail}</a>}
    </p>
    <p>Telefon: {phone}</p>

    <h2>Register</h2>
    <p>{register}</p>
    <p>
      Umsatzsteuer-Identifikationsnummer nach § 27a UStG: {vat}
    </p>

    <h2>Verantwortlich nach § 18 Abs. 2 MStV</h2>
    <p class="whitespace-pre-wrap">{responsible}</p>
    <p class="text-sm" style="color: var(--muted)">
      Für eine reine Werkzeug-Seite ohne journalistisch-redaktionelle Inhalte kann diese Angabe entfallen.
      Der Betreiber entscheidet das; dieses Feld ist nur ein Platzhalter.
    </p>

    <h2>EU-Streitschlichtung</h2>
    <p>
      Die Europäische Kommission unterhält eine Plattform zur Online-Streitbeilegung:
      <a href="https://ec.europa.eu/consumers/odr/" rel="noopener">https://ec.europa.eu/consumers/odr/</a>.
      Wir sind nicht verpflichtet und nicht bereit, an Streitbeilegungsverfahren vor einer
      Verbraucherschlichtungsstelle teilzunehmen — soweit der Betreiber das nicht anders festlegt.
    </p>
  </section>
  <LandingLegalNote locale="de" />
</Base>
