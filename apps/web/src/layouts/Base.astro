---
/**
 * Info-area layout (pivot §11.1/6): plain documentation chrome for everything
 * under /info — tool texts, formats, convert pairs, guides, comparisons,
 * pricing, about, legal, licences. The app itself lives on `/` (AppBase).
 * Pages pass their logical path (e.g. `/formats/jpg`); the `/info` prefix is
 * added here so canonical + hreflang stay correct.
 */
import '../styles/global.css';
import '../styles/info.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import UpdateBanner from '../components/UpdateBanner.tsx';
import DesktopEvents from '../components/DesktopEvents.tsx';
import { branding } from '../lib/branding';
import { THEME_INIT_SCRIPT, brandCssVars, brandFontFaces } from '../lib/theme-vars';
import { INFO_PREFIX, t, type Locale } from '../lib/i18n';
import type { ToolDefinition } from '@neotools/engine';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  tool?: ToolDefinition;
  jsonLd?: unknown[];
  wide?: boolean;
  noindex?: boolean;
}

const { locale, title, description, path, tool, jsonLd = [], wide = false, noindex = false } = Astro.props;
const infoPathValue = path.startsWith(INFO_PREFIX) ? path : path === '/' ? INFO_PREFIX : `${INFO_PREFIX}${path}`;
const themeInit = THEME_INIT_SCRIPT;
const fontFaces = brandFontFaces(branding);
---
<!doctype html>
<html lang={locale} style={brandCssVars(branding)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={branding.colors.primary} />
    <link rel="icon" href={branding.logo} type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Seo locale={locale} title={title} description={description} path={infoPathValue} tool={tool} jsonLd={jsonLd} noindex={noindex} />
    <script is:inline set:html={themeInit} />
    {fontFaces && <style is:inline set:html={fontFaces} />}
  </head>
  <body class="info-body min-h-screen antialiased">
    <a href="#main" class="skip-link">{t(locale, 'skipToContent')}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1" class={wide ? 'info-main info-main-wide' : 'info-main'}>
      <slot />
    </main>
    <Footer locale={locale} />
    <UpdateBanner client:idle locale={locale} />
    <DesktopEvents client:idle />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
  </body>
</html>
