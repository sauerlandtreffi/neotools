---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import ReaderBoot from '../components/ReaderBoot.tsx';
import { branding } from '../lib/branding';
import { tools } from '../lib/registry';
import type { Locale } from '../lib/i18n';
import type { ToolDefinition } from '@neotools/engine';

const toolsJson = JSON.stringify(
  tools.map((tool) => ({ id: tool.id, title: tool.title, description: tool.description })),
);

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  tool?: ToolDefinition;
  jsonLd?: unknown[];
  wide?: boolean;
}

const { locale, title, description, path, tool, jsonLd = [], wide = false } = Astro.props;
const themeInit = `(function(){try{var t=localStorage.getItem('neotools-theme');if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');}catch(e){}})();`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={branding.colors.primary} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Seo locale={locale} title={title} description={description} path={path} tool={tool} jsonLd={jsonLd} />
    <script is:inline set:html={themeInit} />
  </head>
  <body class="min-h-screen antialiased">
    <Header locale={locale} />
    <main class={wide ? 'w-full px-0 pb-8 pt-0' : 'mx-auto w-full max-w-6xl px-4 pb-20 pt-8'}>
      <slot />
    </main>
    <ReaderBoot client:load locale={locale} />
    <Footer locale={locale} />
    <CommandPalette client:idle locale={locale} toolsJson={toolsJson} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
  </body>
</html>
