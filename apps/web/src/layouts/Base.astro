---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import ReaderBoot from '../components/ReaderBoot.tsx';
import ShortcutHelp from '../components/ShortcutHelp.tsx';
import UpdateBanner from '../components/UpdateBanner.tsx';
import DesktopEvents from '../components/DesktopEvents.tsx';
import { branding } from '../lib/branding';
import { THEME_INIT_SCRIPT, brandCssVars, brandFontFaces } from '../lib/theme-vars';
import { listPublicTools } from '../lib/visible-tools';
import { listFormats } from '../data/formats';
import { buildPaletteItems } from '../lib/palette';
import { guideSlugFromId } from '../lib/guides';
import { t, type Locale } from '../lib/i18n';
import type { ToolDefinition } from '@neotools/engine';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  tool?: ToolDefinition;
  jsonLd?: unknown[];
  wide?: boolean;
  noindex?: boolean;
}

const { locale, title, description, path, tool, jsonLd = [], wide = false, noindex = false } = Astro.props;
const themeInit = THEME_INIT_SCRIPT;
const fontFaces = brandFontFaces(branding);

const publicTools = listPublicTools();
let guides: Array<{ slug: string; title: string }> = [];
try {
  const entries = await getCollection('guides');
  guides = entries
    .filter((entry) => entry.data.locale === locale)
    .map((entry) => ({ slug: guideSlugFromId(entry.id, locale), title: entry.data.title }));
} catch {
  guides = [];
}

const itemsJson = JSON.stringify(
  buildPaletteItems(
    locale,
    publicTools.map((item) => ({ id: item.id, title: item.title, description: item.description })),
    listFormats().map((format) => ({ id: format.id, names: format.names })),
    guides,
  ),
);
---
<!doctype html>
<html lang={locale} style={brandCssVars(branding)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={branding.colors.primary} />
    <link rel="icon" href={branding.logo} type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Seo locale={locale} title={title} description={description} path={path} tool={tool} jsonLd={jsonLd} noindex={noindex} />
    <script is:inline set:html={themeInit} />
    {fontFaces && <style is:inline set:html={fontFaces} />}
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="skip-link">{t(locale, 'skipToContent')}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1" class={wide ? 'w-full px-0 pb-8 pt-0' : 'mx-auto w-full max-w-6xl px-4 pb-20 pt-8'}>
      <slot />
    </main>
    <ReaderBoot client:load locale={locale} />
    <Footer locale={locale} />
    <CommandPalette client:idle locale={locale} itemsJson={itemsJson} />
    <ShortcutHelp client:idle locale={locale} />
    <UpdateBanner client:idle locale={locale} />
    <DesktopEvents client:idle />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
  </body>
</html>
