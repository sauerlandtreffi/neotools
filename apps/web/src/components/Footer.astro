---
import LicenseFooter from './LicenseFooter.tsx';
import { branding } from '../lib/branding';
import { infoPath, localizeHref, t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<footer class="info-footer">
  <div class="info-wrap info-footer-row">
    <p>{branding.name} · {locale === 'de' ? 'MIT für eigenen Code · keine AGPL-Laufzeit' : 'MIT for own code · no AGPL runtime'}</p>
    <LicenseFooter
      client:idle
      locale={locale}
      pubkey={branding.licensePubkey ?? ''}
      embedded={branding.license ?? ''}
      showPoweredBy={branding.showPoweredBy !== false}
    />
    <nav class="info-footer-nav">
      <a href={infoPath(locale, locale === 'de' ? '/impressum' : '/imprint')}>{t(locale, 'imprint')}</a>
      <a href={infoPath(locale, locale === 'de' ? '/datenschutz' : '/privacy')}>{t(locale, 'privacy')}</a>
      <a href={infoPath(locale, locale === 'de' ? '/lizenzen' : '/licenses')}>{t(locale, 'licenses')}</a>
      <a href={infoPath(locale, '/no-upload')}>{t(locale, 'noUpload')}</a>
      {branding.footerLinks.map((link) => (
        <a href={localizeHref(locale, link.href)}>{link.label[locale]}</a>
      ))}
    </nav>
  </div>
</footer>
