---
import { branding } from '../lib/branding';
import { localePath, t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<footer class="border-t py-8 text-sm" style="border-color: var(--line); color: var(--muted)">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4">
    <p>{branding.name} · MIT für eigenen Code · keine AGPL-Laufzeit</p>
    <nav class="flex gap-4">
      <a href={localePath(locale, locale === 'de' ? '/impressum' : '/imprint')}>{t(locale, 'imprint')}</a>
      <a href={localePath(locale, locale === 'de' ? '/datenschutz' : '/privacy')}>{t(locale, 'privacy')}</a>
      <a href={localePath(locale, locale === 'de' ? '/lizenzen' : '/licenses')}>{t(locale, 'licenses')}</a>
    </nav>
  </div>
</footer>
