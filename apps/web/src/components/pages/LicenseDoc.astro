---
import { collectLicenses } from '@neotools/engine';
import { getFfmpegCoreFlavor } from '@neotools/tools-media';
import { registry } from '../../lib/registry';
import { groupLicenses, hasCopyleft } from '../../lib/licenses-view';
import { t, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const items = collectLicenses(registry);
const groups = groupLicenses(items);
const copyleft = hasCopyleft(items);
const ffmpegNote = getFfmpegCoreFlavor() === 'lgpl' ? 'ffmpegSourceOfferLgpl' : 'ffmpegSourceOffer';
const labels = {
  permissive: { de: 'Permissiv', en: 'Permissive' },
  copyleft: { de: 'Copyleft (LGPL/GPL)', en: 'Copyleft (LGPL/GPL)' },
  other: { de: 'Weitere', en: 'Other' },
} as const;
---
<h1 class="text-4xl">{t(locale, 'licenses')}</h1>
<p class="mt-3 max-w-2xl" style="color: var(--muted)">
  {locale === 'de'
    ? 'Eigener Code steht unter MIT. Laufzeitbibliotheken kommen aus allen registrierten Packs (Name + Lizenz dedupliziert) plus der Plattformliste.'
    : 'First-party code is MIT. Runtime libraries come from every registered pack (deduped by name + license) plus the platform list.'}
</p>
<p class="mt-2 text-sm">
  <a href="/licenses.json">licenses.json</a> · <a href="/THIRD_PARTY_NOTICES.txt">THIRD_PARTY_NOTICES.txt</a>
</p>

{(copyleft || true) && (
  <aside class="mt-6 rounded-lg border p-4" style="border-color: var(--line)">
    <h2 class="text-xl">{t(locale, 'sourceOffer')}</h2>
    <p class="mt-2 text-sm">{t(locale, 'copyleftNote')}</p>
    <p class="mt-2 text-sm">{t(locale, ffmpegNote)}</p>
  </aside>
)}

{(['permissive', 'copyleft', 'other'] as const).map((family) => (
  groups[family].length > 0 && (
    <section class="mt-8">
      <h2 class="text-2xl">{labels[family][locale]}</h2>
      <ul class="mt-4 grid gap-3">
        {groups[family].map((lic) => (
          <li class="rounded border p-3" style="border-color: var(--line)">
            <strong>{lic.name}</strong>
            <div class="mono text-sm">{lic.license}</div>
            <a href={lic.url}>{lic.url}</a>
          </li>
        ))}
      </ul>
    </section>
  )
))}
