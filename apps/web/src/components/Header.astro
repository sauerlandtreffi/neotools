---
import ThemeToggle from './ThemeToggle.tsx';
import { branding } from '../lib/branding';
import { infoPath, localePath, switchLocalePath, t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const other: Locale = locale === 'de' ? 'en' : 'de';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const switchPath = switchLocalePath(path, locale);
const nav = [
  { href: infoPath(locale, '/tools'), label: t(locale, 'tools') },
  { href: infoPath(locale, '/formats'), label: t(locale, 'formats') },
  { href: infoPath(locale, '/convert'), label: t(locale, 'convert') },
  { href: infoPath(locale, '/guides'), label: t(locale, 'guides') },
  { href: infoPath(locale, locale === 'de' ? '/vergleich/ilovepdf' : '/compare/ilovepdf'), label: t(locale, 'compare') },
  { href: infoPath(locale, locale === 'de' ? '/preise' : '/pricing'), label: t(locale, 'pricing') },
  { href: infoPath(locale, locale === 'de' ? '/ueber' : '/about'), label: t(locale, 'about') },
];
---
<header class="info-header">
  <div class="info-wrap info-header-row">
    <a href={localePath(locale, '/')} class="info-brand" aria-label={branding.name}>
      <img src={branding.logo} alt="" width="22" height="22" />
      <span>{branding.name}</span>
      <span class="info-brand-sep" aria-hidden="true">/</span>
      <span class="info-brand-area">Info</span>
    </a>
    <nav class="info-nav" aria-label="Info">
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href || path.startsWith(`${item.href}/`) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="info-header-tools">
      <a href={localePath(locale, '/')} class="btn btn-primary btn-sm" data-open-app>{t(locale, 'openApp')} →</a>
      <a href={switchPath} hreflang={other} class="mono text-xs uppercase">{other}</a>
      <ThemeToggle client:load locale={locale} compact />
    </div>
  </div>
</header>
