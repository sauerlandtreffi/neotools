---
import { branding } from '../lib/branding';
import { localePath, type Locale } from '../lib/i18n';
import type { ToolDefinition } from '@neotools/engine';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  tool?: ToolDefinition;
  jsonLd?: unknown[];
}

const { locale, title, description, path, tool, jsonLd = [] } = Astro.props;
const site = Astro.site ?? new URL('https://neotools.local');
const canonical = new URL(localePath(locale, path), site).toString();
const deUrl = new URL(localePath('de', path), site).toString();
const enUrl = new URL(localePath('en', path), site).toString();
const fullTitle = `${title} · ${branding.name}`;

const extra: unknown[] = [...jsonLd];
if (tool) {
  extra.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.title[locale],
    description: tool.description[locale],
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  });
  extra.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: branding.name, item: new URL(localePath(locale, '/'), site).toString() },
      { '@type': 'ListItem', position: 2, name: tool.title[locale], item: canonical },
    ],
  });
  if (tool.seo?.faq?.length) {
    extra.push({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: tool.seo.faq.map((item) => ({
        '@type': 'Question',
        name: item.q[locale],
        acceptedAnswer: { '@type': 'Answer', text: item.a[locale] },
      })),
    });
  }
}
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="de" href={deUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={deUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en'} />
{extra.map((block) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
))}
