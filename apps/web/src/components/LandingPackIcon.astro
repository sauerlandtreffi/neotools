---
interface Props {
  pack: string;
  size?: number;
}
const { pack, size = 28 } = Astro.props;
const s = size;
---
<svg
  width={s}
  height={s}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  {pack === 'pdf' && (
    <g>
      <rect x="5" y="3" width="12" height="18" />
      <path d="M8 8h6M8 12h6M8 16h4" />
    </g>
  )}
  {pack === 'forensics' && (
    <g>
      <circle cx="10" cy="10" r="5" />
      <path d="M14 14l5 5" />
      <path d="M8 10h4M10 8v4" />
    </g>
  )}
  {pack === 'image' && (
    <g>
      <rect x="3" y="5" width="18" height="14" />
      <circle cx="8.5" cy="10" r="1.5" />
      <path d="M3 16l5-5 4 4 3-3 6 4" />
    </g>
  )}
  {pack === 'creator' && (
    <g>
      <rect x="4" y="6" width="16" height="12" />
      <path d="M8 10h8M8 14h5" />
      <circle cx="17" cy="7" r="2" />
    </g>
  )}
  {pack === 'a11y' && (
    <g>
      <circle cx="12" cy="5" r="2" />
      <path d="M5 10h14M12 7v6M8 21l4-8 4 8" />
    </g>
  )}
  {pack === 'dach' && (
    <g>
      <path d="M4 11l8-6 8 6" />
      <path d="M6 10.5V20h12v-9.5" />
      <path d="M10 20v-5h4v5" />
    </g>
  )}
  {pack === 'office' && (
    <g>
      <rect x="4" y="4" width="16" height="16" />
      <path d="M4 9h16M9 4v16" />
    </g>
  )}
  {pack === 'media' && (
    <g>
      <rect x="3" y="6" width="14" height="12" />
      <path d="M17 10l4-2v8l-4-2z" />
    </g>
  )}
  {pack === 'speech' && (
    <g>
      <path d="M8 10a4 4 0 0 1 8 0v2a4 4 0 0 1-8 0z" />
      <path d="M6 11v1a6 6 0 0 0 12 0v-1M12 18v3" />
    </g>
  )}
  {pack === 'archive' && (
    <g>
      <path d="M4 7h16v12H4z" />
      <path d="M4 7l2-3h12l2 3" />
      <path d="M10 12h4" />
    </g>
  )}
  {!['pdf', 'forensics', 'image', 'creator', 'a11y', 'dach', 'office', 'media', 'speech', 'archive'].includes(pack) && (
    <g>
      <rect x="5" y="5" width="14" height="14" />
      <path d="M8 12h8" />
    </g>
  )}
</svg>
