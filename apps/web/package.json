    "e2e": "playwright test",
    "check:reader": "node ../../scripts/check-reader-dist.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.1",
    "@astrojs/sitemap": "^3.5.1",
    "@neotools/engine": "workspace:*",
