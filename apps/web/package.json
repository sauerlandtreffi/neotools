    "@neotools/models": "workspace:*",
    "@neotools/parsers": "workspace:*",
    "@neotools/tools-archive": "workspace:*",
    "@neotools/tools-creator": "workspace:*",
    "@neotools/tools-dach": "workspace:*",
    "@neotools/tools-forensics": "workspace:*",
    "@neotools/tools-image": "workspace:*",
    "@neotools/tools-image-ai": "workspace:*",
    "@neotools/tools-media": "workspace:*",
    "@neotools/tools-office": "workspace:*",
    "@neotools/tools-pdf": "workspace:*",
    "@neotools/tools-speech": "workspace:*",
    "@preact/signals": "^2.11.2",
    "@tauri-apps/api": "^2.9.1",
    "astro": "^5.13.7",
    "comlink": "^4.4.2",
    "dompurify": "^3.2.6",
    "fflate": "^0.8.2",
    "marked": "^15.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "preact": "^10.27.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.18.1",
    "fake-indexeddb": "^6.2.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
