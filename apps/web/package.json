{
  "name": "@neotools/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node ../../scripts/copy-wasm-assets.mjs && node ../../scripts/fetch-tessdata.mjs --optional",
