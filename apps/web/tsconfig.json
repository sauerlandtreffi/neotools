{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@neotools/engine": ["../../packages/engine/src/index.ts"],
      "@neotools/engine/platform/browser": ["../../packages/engine/src/platform/browser.ts"],
      "@neotools/tools-pdf": ["../../packages/tools-pdf/src/index.ts"],
      "@neotools/tools-forensics": ["../../packages/tools-forensics/src/index.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "test/**/*"]
}
