{
  "id": "/",
  "name": "NeoTools",
  "short_name": "NeoTools",
  "description": "Lokale PDF-Werkzeuge ohne Upload.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0c1210",
  "theme_color": "#10221c",
  "lang": "de",
  "icons": [
    { "src": "/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "share_target": {
    "action": "/open",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", "image/png", "image/jpeg"]
        }
      ]
    }
  },
  "shortcuts": [
    { "name": "PDF zusammenführen", "url": "/pdf-merge" },
    { "name": "Seiten ordnen", "url": "/pdf-reorder" },
    { "name": "Bereinigen", "url": "/pdf-sanitize" },
    { "name": "PDF öffnen", "url": "/open" }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
